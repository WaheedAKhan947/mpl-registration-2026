# Copy this file to .env.local and fill in your own values

# MongoDB connection string (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/mpl?retryWrites=true&w=majority

# Secret used to sign the admin login session cookie (any long random
# string). Generate one with `openssl rand -hex 32`. Treat it like a
# password -- anyone with it can forge admin session cookies. Rotating it
# instantly logs out every admin session.
SESSION_SECRET=change-this-to-a-long-random-string

# Admin accounts (name, email, password, role) are stored in MongoDB, not in
# an env var. Bootstrap the first account after setting MONGODB_URI and
# SESSION_SECRET above:
#   node --env-file=.env.local scripts/create-admin.js --name "Your Name" --email you@example.com --password "a strong password"
# The first account created becomes an "owner" automatically, and can add
# teammates from the dashboard's Settings > Team access panel.

# Cloudflare R2 (S3-compatible object storage) for profile pictures, CNIC
# images, and fee receipts. The bucket should be kept PRIVATE -- the admin
# dashboard reads files via short-lived signed URLs, not public links.
# Account ID and API token are in the Cloudflare dashboard under R2 > Manage API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
